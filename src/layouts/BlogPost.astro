---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import { getCategoryPath } from '../categories';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · Niwde`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main class="article-shell" data-pagefind-body>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1080} height={540} src={heroImage} alt="" />
						</div>
					)
				}
				<header class="article-header">
					<a class="eyebrow category-link" href={getCategoryPath(category)}>{category}</a>
					<h1>{title}</h1>
					<p class="lead">{description}</p>
					<div class="meta">
						<span><FormattedDate date={pubDate} /></span>
						{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
					</div>
					<div class="tags">{tags.map((tag) => <span class="pill">{tag}</span>)}</div>
				</header>
				<div class="prose"><slot /></div>
				<Comments />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-shell { width: min(100% - 2rem, 820px); }
	.hero-image { margin-bottom: 2.5rem; }
	.hero-image img { box-shadow: var(--shadow); }
	.article-header { margin-bottom: 3rem; }
	.category-link { display: inline-block; text-decoration: none; }
	.article-header h1 { max-width: 16ch; font-size: clamp(2.5rem, 7vw, 4.7rem); }
	.lead { max-width: 680px; color: var(--text-soft); font-size: 1.2rem; }
	.meta, .tags { display: flex; flex-wrap: wrap; gap: 0.65rem; }
	.meta { margin: 1.25rem 0; color: var(--text-soft); font-size: 0.88rem; }
	.prose :global(h2), .prose :global(h3) { margin-top: 2.5rem; }
	.prose :global(p), .prose :global(li) { max-width: 72ch; }
	.prose :global(table) { width: 100%; border-collapse: collapse; }
	.prose :global(th), .prose :global(td) { padding: 0.75rem; border: 1px solid var(--border); text-align: left; }
</style>
