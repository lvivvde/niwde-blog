---
import type { CollectionEntry } from 'astro:content';
import { getCategoryFromEntryId, getCategoryPath, getPostSlug } from '../../categories';
import FormattedDate from '../FormattedDate.astro';
interface Props {
  posts: CollectionEntry<'blog'>[];
  emptyMessage?: string;
}
const { posts, emptyMessage = '这个分类还没有文章。' } = Astro.props;
---

{posts.length ? <ul class="post-list">{posts.map((post) => {
  const category = getCategoryFromEntryId(post.id);
  return <li>
    <div class="post-date"><FormattedDate date={post.data.pubDate} compact /></div>
    <div class="post-entry">
      <a class="post-title" href={`/blog/${getPostSlug(post.id)}/`}>{post.data.title}</a>
      <a class="post-category" href={getCategoryPath(category.name)}>{category.name}</a>
    </div>
  </li>;
})}</ul> : <p class="muted">{emptyMessage}</p>}

<style>
  .post-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; align-items: baseline; }
  .post-date { color: var(--text-soft); font-size: .75rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .post-entry { min-width: 0; }
  .post-title { color: var(--text); text-decoration: none; line-height: 1.65; overflow-wrap: anywhere; }
  .post-title:hover { color: var(--accent-strong); text-decoration: underline; }
  .post-category { display: block; margin-top: .1rem; color: var(--text-soft); font-size: .7rem; text-decoration: none; }
  .post-category:hover { color: var(--accent-strong); }
  @media (max-width: 480px) { li { grid-template-columns: 5.6rem minmax(0, 1fr); gap: .7rem; } .post-date { font-size: .675rem; } }
</style>
