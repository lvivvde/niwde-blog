---
interface Props { date: Date; compact?: boolean; }
const { date, compact = false } = Astro.props;
const formatted = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'UTC', year: 'numeric', month: compact ? '2-digit' : 'long', day: compact ? '2-digit' : 'numeric',
}).format(date);
---
<time datetime={date.toISOString()}>{compact ? formatted.replaceAll('/', '-') : formatted}</time>
