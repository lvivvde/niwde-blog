---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/blog/CategoryNav.astro';
import PostList from '../../components/blog/PostList.astro';
import { getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
---
<BaseLayout title="文章 · Niwde">
  <header class="page-header"><h1>文章</h1><p>{posts.length} 篇，按时间排列。</p><CategoryNav /></header>
  {years.map((year) => <section class="archive-year" aria-labelledby={`year-${year}`}><h2 id={`year-${year}`}>{year}</h2><PostList posts={posts.filter((post) => post.data.pubDate.getUTCFullYear() === year)} /></section>)}
  {!posts.length && <p class="muted">还没有文章。</p>}
</BaseLayout>
<style>
  .archive-year + .archive-year { margin-top: 2.5rem; }
  .archive-year > h2 { margin-bottom: 1.25rem; color: var(--text-soft); font-size: .875rem; font-weight: 500; }
</style>
