---
import { getCollection } from 'astro:content';
import CategoryNav from '../../components/CategoryNav.astro';
import PostList from '../../components/PostList.astro';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PageLayout title="文章 · Niwde" description="游戏后端、AI 开发、项目实验与随笔复盘。">
	<header class="page-header">
		<p class="eyebrow">Writing</p>
		<h1>文章</h1>
		<p>从真实项目出发，记录能复用的方法，也保留失败与不确定性。</p>
		<CategoryNav />
	</header>
	<PostList posts={posts} emptyMessage="还没有公开文章。" />
</PageLayout>

<style>
	.page-header { max-width: 720px; margin-bottom: 4rem; }
	.page-header h1 { margin-bottom: 1rem; }
	.page-header > p:not(.eyebrow) { color: var(--text-soft); font-size: 1.15rem; }
</style>
