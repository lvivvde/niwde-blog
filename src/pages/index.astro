---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { REALMMESH_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div>
			<p class="eyebrow">Game Backend × AI Practice</p>
			<h1>写游戏后端，也记录 AI 如何改变开发。</h1>
			<p class="intro">这里是 Niwde 的技术笔记：C++、Lua、游戏服务端，以及 AI 主导编码之后真正需要验证的问题。</p>
			<div class="actions">
				<a class="primary" href="/blog">阅读文章</a>
				<a href={REALMMESH_URL}>查看 RealmMesh ↗</a>
			</div>
		</div>
		<aside class="card">
			<p class="eyebrow">正在进行</p>
			<h2>RealmMesh</h2>
			<p>一个采用帧驱动模型的 C++ 游戏服务端。生产代码与测试代码由 AI 生成，我负责需求、架构边界、审查与验收。</p>
			<div class="stack"><span>C++20</span><span>Lua 5.4</span><span>AI Coding</span></div>
		</aside>
	</section>

	<section class="recent">
		<div class="section-heading">
			<div><p class="eyebrow">Latest Notes</p><h2>最近文章</h2></div>
			<a href="/blog">全部文章 →</a>
		</div>
		<div class="post-grid">
			{
				posts.map((post) => (
					<a class="post-card" href={`/blog/${post.id}/`}>
						<div><span class="pill">{post.data.category}</span><FormattedDate date={post.data.pubDate} /></div>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
					</a>
				))
			}
		</div>
	</section>
</PageLayout>

<style>
	.hero { display: grid; grid-template-columns: 1.45fr 0.8fr; gap: 4rem; align-items: center; min-height: 60vh; }
	.hero h1 { max-width: 12ch; }
	.intro { max-width: 620px; color: var(--text-soft); font-size: 1.18rem; }
	.actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 2rem; }
	.actions a { font-weight: 700; text-decoration: none; }
	.actions .primary { padding: 0.7rem 1rem; border-radius: 10px; background: var(--accent); color: #071a18; }
	.hero aside { padding: 2rem; transform: rotate(1deg); }
	.hero aside h2 { font-size: 2.2rem; }
	.stack { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.stack span { padding: 0.3rem 0.55rem; border-radius: 7px; background: var(--accent-soft); color: var(--accent-strong); font-size: 0.78rem; }
	.recent { margin-top: 5rem; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 1.5rem; }
	.section-heading .eyebrow { margin-bottom: 0.35rem; }
	.post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
	.post-card { display: block; padding: 1.5rem; border: 1px solid var(--border); border-radius: 16px; background: var(--surface-raised); color: var(--text); text-decoration: none; }
	.post-card:hover { border-color: var(--accent); transform: translateY(-2px); }
	.post-card > div { display: flex; justify-content: space-between; align-items: center; color: var(--text-soft); font-size: 0.8rem; }
	.post-card h3 { margin-top: 1.25rem; }
	.post-card p { margin: 0; color: var(--text-soft); }
	@media (max-width: 760px) {
		.hero { grid-template-columns: 1fr; gap: 2rem; min-height: auto; }
		.hero aside { transform: none; }
		.post-grid { grid-template-columns: 1fr; }
	}
</style>
