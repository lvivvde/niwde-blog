---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_CATEGORIES, getCategoryFromEntryId } from '../../categories';
import { getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
---
<BaseLayout title="分类 · Niwde">
  <header class="page-header"><h1>分类</h1><p>按主题查阅文章。</p></header>
  <ul class="categories">{BLOG_CATEGORIES.map((category) => {
    const count = posts.filter((post) => getCategoryFromEntryId(post.id).name === category.name).length;
    return <li><div><a href={`/categories/${category.slug}/`}>{category.name}</a><span>{count} 篇</span></div><p>{category.description}</p></li>;
  })}</ul>
</BaseLayout>
<style>
  .categories { margin: 0; padding: 0; list-style: none; }
  li { padding: 1.25rem 0; border-bottom: 1px solid var(--border); }
  li:first-child { padding-top: 0; }
  li > div { display: flex; justify-content: space-between; gap: 1rem; }
  a { color: var(--text); text-decoration: none; }
  a:hover { color: var(--accent-strong); text-decoration: underline; }
  span { color: var(--text-soft); font-size: .75rem; }
  p { margin: .35rem 0 0; color: var(--text-soft); font-size: .8rem; }
</style>
