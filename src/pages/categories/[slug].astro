---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/blog/CategoryNav.astro';
import PostList from '../../components/blog/PostList.astro';
import { BLOG_CATEGORIES, getCategoryFromEntryId } from '../../categories';
import { getPublishedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return BLOG_CATEGORIES.map((category) => ({ params: { slug: category.slug }, props: { category, posts: posts.filter((post) => getCategoryFromEntryId(post.id).name === category.name) } }));
}
interface Props { category: (typeof BLOG_CATEGORIES)[number]; posts: CollectionEntry<'blog'>[]; }
const { category, posts } = Astro.props;
---
<BaseLayout title={`${category.name} · Niwde`} description={category.description}>
  <header class="page-header"><h1>{category.name}</h1><p>{category.description}</p><CategoryNav current={category.name} /></header>
  <PostList posts={posts} />
</BaseLayout>
