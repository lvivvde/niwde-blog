---
// 页面 /ai-course/：面向课堂听众的大屏内容页；按我自己的编程工作流线性展开。
import PageLayout from '../layouts/PageLayout.astro';

const checkpoints = [
	{ n: 1, name: '需求对齐', summary: '表达目标、成功标准，并提前设计验证回路' },
	{ n: 2, name: 'AI 的上下文采集', summary: '只提供最小、充分、高信号的证据' },
	{ n: 3, name: 'AI 写代码', summary: '由验证标准驱动，一步一步完成代码' },
	{ n: 4, name: 'AI 自验证', summary: '按约定的验证回路自动检查交付结果' },
	{ n: 5, name: 'Code Review', summary: '分两轴查：写法合不合规范，功能有没有做对' },
];

const promptContract = [
	{ key: 'Goal', title: '目标', text: '描述要改变的用户或业务结果，先不定代码步骤。' },
	{ key: 'Success', title: '成功标准', text: '把“做好”写成可观察、可证伪的行为。' },
	{ key: 'Bounds', title: '边界', text: '明确必须保持、允许的副作用，以及本次不做什么。' },
	{ key: 'Context', title: '上下文边界', text: '先定义需要哪些事实、哪些来源可信；具体的采集放到下一步。' },
	{ key: 'Output', title: '输出契约', text: '约定交付物、结构、长度和必须附带的证据。' },
	{ key: 'Unknowns', title: '未知项协议', text: '低影响项说明假设；关键缺口先提问；高风险动作必须停止。' },
	{ key: 'Verify', title: '验证回路', text: '提前约定运行哪些检查、什么结果算通过，以及怎样报告未验证风险。' },
];

const promptExtensions = [
	{ title: '示例与边界案例', text: '用“输入 → 期望行为”说明正确处理；反例优先变成测试用例。' },
	{ title: '输出是接口', text: '人读结果约定结构；机器读结果优先使用 schema 或 Structured Outputs。' },
	{ title: '数据不是指令', text: '区分任务要求与网页、Issue、工具输出中的不可信内容，声明权限边界。' },
	{ title: 'Prompt 也要回归', text: '固定样本集，一次只改一个主要变量；模型升级后重新运行评测。' },
];

const contextLayers = [
	{ layer: '目标上下文', q: '为什么做、什么算成功、边界是什么？', src: '需求 Spec、Issue、验收标准' },
	{ layer: '结构上下文', q: '改动点与哪些调用者、依赖、测试、流程相连？', src: '代码图、LSP、grep、目录结构' },
	{ layer: '行为上下文', q: '代码当前真实做什么？', src: '源码、配置、schema、运行日志' },
	{ layer: '验证上下文', q: '怎样证伪或确认修改？', src: '单元/集成测试、类型检查、监控' },
	{ layer: '历史决策上下文', q: '为什么形成当前结构？哪些约束仍有效？', src: 'Git log/blame、ADR、Issue、PR' },
];

const demoSteps = [
	'从需求 Spec 提取目标、边界和待回答的问题',
	'从入口追到调用者、依赖、数据与相关测试',
	'选择 3–6 个高信号文件，不必打开整个仓库',
	'回读源码、配置与 schema，确认当前真实行为',
	'用 Git / ADR / Issue 补齐设计原因与历史约束',
	'记录证据、未知项和冲突，再进入 AI 写代码',
];

const contextPicks = [
	{ label: '需求 Spec', good: true },
	{ label: '相关模块的公开接口', good: true },
	{ label: '调用入口与关键调用者', good: true },
	{ label: '直接依赖的契约与错误语义', good: true },
	{ label: '相关数据约束与配置', good: true },
	{ label: '相关测试', good: true },
	{ label: '一条仍有效的历史决策', good: true },
	{ label: '与目标无直接关系的目录', good: false },
	{ label: '未经筛选的整仓源码', good: false },
	{ label: '全部历史日志与讨论', good: false },
	{ label: '本次明确排除的系统资料', good: false },
];

const contextToolNotes = [
	{ k: 'Tree-sitter 解析', v: '把仓库解析成 AST，再建成节点（函数、类、导入）与边（调用、继承、测试覆盖）的代码图' },
	{ k: '沿调用链取子图', v: '从入口点追踪执行流与影响半径，只把相关子图交给模型' },
	{ k: '仓库内持久化', v: '图存于仓库内本地 SQLite，按文件哈希增量重建，不必每次全量索引' },
];

const ctxMix = [
	{ label: '系统提示与指令文件', pct: 12, tone: 't1', note: '行为约束、项目 CLAUDE.md 等，启动即加载' },
	{ label: '工具与 MCP 定义', pct: 10, tone: 't2', note: '工具名与服务器说明先进来，用到具体工具才展开' },
	{ label: '技能描述', pct: 8, tone: 't3', note: '每个技能正文上限 5,000 tokens，总计 25,000' },
	{ label: '记忆与项目文档', pct: 15, tone: 't4', note: '自动记忆取前 200 行或 25KB，先到为准' },
	{ label: '对话消息', pct: 40, tone: 't5', note: '你的提问、文件读取、工具输出、分析与编辑' },
	{ label: '留白', pct: 15, tone: 't6', note: '预留给后续检索与生成的空间' },
];

const ctxCacheNotes = [
	{ k: '一段事，留在同一个会话', v: '前缀不变，缓存才能一直命中；一个需求单开一堆会话，等于把前缀拆散重写' },
	{ k: '别把会话晾太久', v: '默认寿命只有几分钟量级；开个会、摸鱼几十分钟回来，热前缀已经冷了' },
	{ k: '续聊不是免费的', v: '缓存掉了再续，前面那一段向量要重新算一遍，延迟和写入成本一起回来' },
];

const tddWhy = [
	{ k: '把大块切成小块', v: '一次只让一条检查变绿，大模块被迫拆开，留下能单独替换、单独验证的接缝' },
	{ k: '接缝让测试和阅读都容易', v: '接口就是测试面；接缝清楚，改一处的影响范围看得见，后来的人和 AI 都读得下去' },
	{ k: '压住 AI 的过度设计', v: '没有检查会失败的方法就没有存在理由，AI 不再顺手补一堆没人要的包装方法' },
];

const agentRoles = [
	{ role: '父 Agent', duty: '定目标、拆任务、写下要交出去的那段摘要、验收结果；全局视野和最终判断留在这一层' },
	{ role: '子 Agent', duty: '只干一件能被验收的事；在自己的窗口里翻日志、读文件、试错，只把结论带回来' },
];

const agentRules = [
	{ k: '子 Agent 用同档模型', v: '配置上可以直接继承主对话的模型。用弱档省下的差价，往往以“父 Agent 再把结果审一遍、甚至重做”还回去' },
	{ k: '交付物是一份短 MD', v: '只写结论、证据位置和改动点，不粘贴文件内容；子 Agent 的作用就是把文件挡在主对话外面' },
	{ k: '父 Agent 只传一份任务摘要', v: '子 Agent 另起一个干净窗口，看不到主对话的历史、已调用的技能和已读过的文件' },
	{ k: '规则和记忆分开放', v: '项目指令文件会跟着每个子 Agent 进去，自动记忆默认不会；想让一条规则传下去就写进指令文件' },
];

const integrationStacks = [
	{ lang: 'Lua', tools: 'Busted · luaunit · Telescope' },
	{ lang: 'C++', tools: 'GoogleTest · Catch2 · doctest' },
	{ lang: 'Rust', tools: 'cargo test（内置）' },
	{ lang: 'Go', tools: 'testing · net/http/httptest（内置）' },
	{ lang: 'Python', tools: 'pytest' },
	{ lang: 'JavaScript / TypeScript', tools: 'Vitest · Jest' },
	{ lang: 'Java', tools: 'JUnit 5' },
	{ lang: 'C# / .NET', tools: 'xUnit · NUnit' },
];

const integrationCitizens = [
	{ k: 'Rust 把它放进独立目录', v: '集成测试写在 tests/ 下，编译成独立的 crate，只能走公开接口。官方定义：这类测试「entirely external to your library」' },
	{ k: 'Go 允许独立的外部测试包', v: '测试文件可以放在带 _test 后缀的包里，和被测包分开，只能看见导出的标识符' },
	{ k: 'Java 给它独立的构建阶段', v: 'Maven 用 Failsafe 插件在 integration-test 与 verify 阶段跑集成测试，与跑单元测试的 Surefire 分开，mvn verify 才触发' },
];

const tddLoop = [
	{ k: '红', v: '先写一个会失败的检查。一条从没失败过的检查，你没有证据说明它真的在测东西' },
	{ k: '绿', v: '写刚好够用的实现让它变绿；没有检查撑腰的代码，就是没被验证过的代码' },
	{ k: '重构', v: '在检查全绿的前提下改结构，改完还绿说明行为没变。这一步的底气全部来自上一步留下的检查' },
];

const crAxes = [
	{
		tag: 'Standard · 规范',
		name: '写法是否和这个仓库一致',
		q: '这段改动放在这里，像不像这个仓库自己写的？',
		facts: [
			{ k: '拿什么判', v: '仓库里写下来的规范文档、语言的 style guide，再加一份坏味道清单兜底' },
			{ k: '要什么上下文', v: '只要这段 diff 和规范来源，不需要需求文档' },
			{ k: '谁来做', v: '一半能交给工具（格式化、lint）；剩下的是判断题，交给子 Agent 机械扫一遍' },
			{ k: '抓不住', v: '改动有没有满足需求。规范全对，功能照样可以是错的' },
		],
	},
	{
		tag: 'Spec · 功能',
		name: '是否实现了功能需求',
		q: '需求 Spec 里那几条成功标准，这段改动真的做成了吗？',
		facts: [
			{ k: '拿什么判', v: '需求 Spec 的成功标准，和 Verification Plan 承诺的通过证据' },
			{ k: '要什么上下文', v: '需求、验证证据、改动，三样缺一不可' },
			{ k: '谁来做', v: '子 Agent 给出 Recommendation，主 Agent 汇总，人做最终判断，这个责任交不出去' },
			{ k: '抓不住', v: '写法。功能全对，代码也可以烂到没人敢改' },
		],
	},
];

const crDispatch = [
	{ k: '主 Agent 派发', v: '同一份 diff 派给两个子 Agent，各自只带自己那一轴要的上下文：一个只拿 diff 和规范来源，一个只拿需求、验证证据和 diff' },
	{ k: '子 Agent 各审一轴', v: '规范那条只报写法问题，功能那条只报需求问题，各交一份 Findings 报告，互不掺和' },
	{ k: '主 Agent 汇总', v: '两份报告合成一张清单，去重、判严重性，再交给人做最终判断' },
];

const crStdSources = [
	{ k: '仓库自己写下来的', v: 'CONTRIBUTING.md、CODING_STANDARDS.md 这类文档。它最优先，和语言通用风格冲突时以它为准' },
	{ k: '语言的 style guide', v: '仓库没写明的，看语言或社区的 style guide；连它也没规定，就跟周边已有代码保持一致' },
	{ k: '坏味道清单兜底', v: '前两层都没覆盖的，用一份固定的代码坏味道清单兜底（Fowler《重构》第 3 章那批，如重复代码、发散式变化、夸夸其谈通用性）。Fowler 自己写的定义是「smells don\'t always indicate a problem」，所以每条都只是“疑似”，推翻不了上面两层' },
];

