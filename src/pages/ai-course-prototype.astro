const shallowCode = `function claimReward(player, event):
  if not eligibility.check(player, event):      # 查资格
    return Ineligible(reason)
  existing = claimStore.find(player, event)     # 查领取记录
  if existing:
    return existing
  reward = rewardService.grant(player, event)   # 发奖
  claimStore.save(player, event, reward)        # 保存结果
  # 超时后怎么办？调用方自己决定要不要重发
  return reward`;

const deepCode = `result = rewardClaim.claim(player, event)

# 领取模块只暴露一个入口和三种结果：
