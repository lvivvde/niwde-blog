<script>
	// 原型脚本：变体切换（URL 参数 + 键盘 + 底部条）、互动揭示、复制、目录联动。仅用于 /ai-course-prototype/。
	const order = ['A', 'B', 'C'];
	const names = { A: '演讲舞台', B: '工程地图', C: '讲师手册' };
	const variants = Array.from(document.querySelectorAll('[data-page-variant]'));

	const fromURL = () => {
		const v = new URLSearchParams(location.search).get('variant');
		return order.includes(v ?? '') ? v : 'A';
	};
	let current = fromURL();

	function applyVariant(v, write) {
		current = v;
		for (const el of variants) el.hidden = el.getAttribute('data-page-variant') !== v;
		document.querySelectorAll('[data-label]').forEach((el) => {
			el.textContent = `${v} · ${names[v]}`;
		});
		if (write) history.replaceState(null, '', `?variant=${v}`);
		window.scrollTo({ top: 0, behavior: 'instant' });
	}
	applyVariant(current, false);

	const switcher = document.querySelector('[data-switcher]');
	if (switcher) {
		switcher.querySelectorAll('[data-dir]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const dir = Number(btn.getAttribute('data-dir'));
				const next = order[(order.indexOf(current) + dir + order.length) % order.length];
				applyVariant(next, true);
			});
		});
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			if (e.altKey || e.ctrlKey || e.metaKey) return;
			const t = e.target;
			if (t instanceof Element && (t.closest('input, textarea, select') || t.isContentEditable)) return;
			const dir = e.key === 'ArrowLeft' ? -1 : 1;
			applyVariant(order[(order.indexOf(current) + dir + order.length) % order.length], true);
		});
	}

	// 互动题三步：题目 → 邀请口头选择 → 揭示推荐判断/证据/误区。
	document.addEventListener('click', (e) => {
		const btn = e.target instanceof Element ? e.target.closest('[data-reveal]') : null;
		if (!btn) return;
		const quiz = btn.closest('[data-quiz]');
		if (!quiz) return;
		const panel = quiz.querySelector('[data-quiz-panel]');
		const invite = quiz.querySelector('[data-quiz-invite]');
		if (panel) panel.removeAttribute('hidden');
		if (invite) invite.setAttribute('hidden', '');
		btn.setAttribute('hidden', '');
		quiz.classList.add('is-revealed');
	});

	// 选项 chip：讲师可点击标记口头选择。
	document.querySelectorAll('.chip-toggle').forEach((chip) => {
		chip.addEventListener('click', () => {
			const on = chip.getAttribute('aria-pressed') === 'true';
			chip.setAttribute('aria-pressed', on ? 'false' : 'true');
		});
	});

	// 模板复制：只复制干净的空白模板文本。
	document.addEventListener('click', async (e) => {
		const btn = e.target instanceof Element ? e.target.closest('[data-copy]') : null;
		if (!btn) return;
		const src = document.querySelector(btn.getAttribute('data-copy') ?? '');
		if (!src) return;
		const label = btn.textContent;
		try {
			await navigator.clipboard.writeText(src.textContent.trim());
			btn.textContent = '已复制 ✓';
		} catch {
			btn.textContent = '复制失败，请手动选择文本';
		}
		setTimeout(() => {
			btn.textContent = label;
		}, 1800);
	});

	// 目录 / 地图 / 进度条与章节联动。
	const sections = document.querySelectorAll('[data-stop-section]');
	if ('IntersectionObserver' in window && sections.length) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const key = entry.target.getAttribute('data-stop');
					const v = entry.target.getAttribute('data-variant');
					document
						.querySelectorAll(`[data-stop-marker][data-variant="${v}"]`)
						.forEach((m) => m.classList.toggle('is-current', m.getAttribute('data-stop') === key));
				}
			},
			{ rootMargin: '-15% 0px -60% 0px' }
		);
		sections.forEach((s) => io.observe(s));
	}

	// 打印时展开全部讲师备注。
	window.addEventListener('beforeprint', () => {
		document.querySelectorAll('details').forEach((d) => {
			d.open = true;
		});
	});
</script>

