		line-height: 1.65;
		overflow-x: auto;
		white-space: pre;
	}
	.btn {
		display: inline-block;
		padding: 0.5rem 1.1rem;
		border: 0;
		border-radius: 10px;
		background: var(--accent);
		color: var(--accent-soft);
		font: inherit;
		font-weight: 700;
		font-size: 0.9rem;
		cursor: pointer;
	}
	.btn:hover {
		background: var(--accent-strong);
	}
	.chip {
		display: inline-flex;
		align-items: center;
		padding: 0.32rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-raised);
		color: var(--text);
		font: inherit;
		font-size: 0.86rem;
		cursor: pointer;
	}
	.chip[aria-pressed='true'] {
		background: var(--accent-soft);
		border-color: var(--accent);
		color: var(--accent-strong);
		font-weight: 600;
	}
	.quiz {
		margin: 1.25rem 0;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--accent);
		border-radius: 16px;
		background: var(--surface-raised);
		box-shadow: var(--shadow);
	}
	.quiz-tag {
		margin: 0 0 0.4rem;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.quiz-q {
		font-size: 1.08rem;
		font-weight: 600;
	}
	.quiz-opts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0;
	}
	.quiz-chips {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}
	.quiz-chips .chip {
		justify-content: flex-start;
	}
	.quiz-invite {
		color: var(--accent-strong);
		font-weight: 600;
	}
	.quiz .btn {
		margin-top: 0.25rem;
	}
	.quiz.is-revealed .chip[data-good]::after {
		content: ' · 推荐';
		color: var(--accent-strong);
		font-weight: 700;
	}
	.quiz.is-revealed .chip[data-noise]::after {
		content: ' · 噪声';
		color: #c05b3a;
		font-weight: 700;
	}
	.quiz-panel {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 2px solid var(--accent-soft);
	}
	.quiz-panel p {
		margin: 0 0 0.5rem;
		font-size: 0.95rem;
	}
	.notes {
		margin: 1.25rem 0;
		padding: 0.75rem 1.1rem;
		border: 1px dashed var(--border);
		border-radius: 12px;
		background: color-mix(in srgb, var(--surface-raised) 65%, transparent);
	}
	.notes summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--text-soft);
	}
	.notes ul {
		margin: 0.6rem 0;
		padding-left: 1.2rem;
	}
	.notes-line {
		margin: 0.4rem 0 0;
		font-size: 0.95rem;
	}
	.practice {
		margin: 1.25rem 0;
		padding: 0.9rem 1.2rem;
		border-left: 4px solid var(--accent);
		border-radius: 0 12px 12px 0;
		background: var(--accent-soft);
	}
	.practice .who {
		margin: 0 0 0.25rem;
		color: var(--accent-strong);
		font-weight: 700;
		font-size: 0.82rem;
		letter-spacing: 0.06em;
	}
	.practice p:last-child {
		margin: 0;
	}
	.correction {
		padding: 0.6rem 1rem;
		border-left: 4px solid #c05b3a;
		border-radius: 0 10px 10px 0;
		background: color-mix(in srgb, #c05b3a 8%, var(--surface-raised));
	}
	.takeaway {
		font-size: 1.05rem;
	}
	.steps {
		padding-left: 0;
		list-style: none;
		counter-reset: step;
	}
	.steps li {
		counter-increment: step;
		padding: 0.45rem 0 0.45rem 2.2rem;
		position: relative;
		border-bottom: 1px dashed var(--border);
	}
	.steps li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 0.45rem;
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		background: var(--accent);
		color: var(--accent-soft);
		font-size: 0.8rem;
		font-weight: 700;
	}
	.cpflow {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0;
	}
	.cpflow-item {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-raised);
		font-size: 0.9rem;
	}
	.cpflow-item b {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 50%;
		background: var(--accent);
		color: var(--accent-soft);
		font-size: 0.78rem;
	}
	.fbeat {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.75rem;
		padding: 0;
		margin: 1.25rem 0;
		list-style: none;
	}
	.fbeat li {
		padding: 0.8rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface-raised);
	}
	.fbeat h3 {
		margin: 0 0 0.35rem;
		color: var(--accent-strong);
		font-size: 0.82rem;
		letter-spacing: 0.05em;
	}
	.fbeat p {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
	}
	.prompt-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin: 1.25rem 0;
	}
	.prompt-card {
		padding: 1rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface-raised);
	}
	.prompt-card h4 {
		margin: 0 0 0.5rem;
		font-size: 0.95rem;
	}
	.prompt-bad h4 {
		color: #c05b3a;
	}
	.prompt-good {
		border-color: var(--accent);
	}
	.prompt-good h4 {
		color: var(--accent-strong);
	}
	.rgr {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
		padding: 0;
		margin: 1.25rem 0;
		list-style: none;
	}
	.rgr-round {
		padding: 0.9rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface-raised);
	}
	.rgr-round header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}
	.rgr-n {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent-strong);
		font-size: 0.72rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.rgr-round p {
		margin: 0.35rem 0;
		font-size: 0.84rem;
		line-height: 1.55;
	}
	.rgr-round p b {
		display: inline-block;
		min-width: 4.2rem;
		color: var(--accent-strong);
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.matrix {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		margin: 1.25rem 0;
	}
	.matrix span {
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface-raised);
		font-size: 0.9rem;
	}
	.matrix span:first-child {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent-strong);
		font-weight: 700;
	}
	.mgrid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin: 1.25rem 0;
	}
	.mcard {
		padding: 1rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface-raised);
	}
	.mcard h4 {
		margin: 0 0 0.4rem;
		font-size: 0.95rem;
	}
	.mcard-shallow {
		border-left: 4px solid #c05b3a;
	}
	.mcard-deep {
		border-left: 4px solid var(--accent);
	}
	.echain {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: stretch;
		padding: 0;
		margin: 1.25rem 0;
		list-style: none;
	}
	.echain li {
		flex: 1 1 180px;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.8rem 1rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface-raised);
	}
	.echain span {
		color: var(--text-soft);
		font-size: 0.85rem;
	}
	.suspense {
		margin: 1.25rem 0;
		padding: 1rem 1.2rem;
		border: 2px dashed var(--accent);
		border-radius: 14px;
		background: var(--surface-raised);
	}
	.suspense-q {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--accent-strong);
	}
	.tbl {
		width: 100%;
		border-collapse: collapse;
		margin: 1rem 0;
		font-size: 0.9rem;
	}
	.tbl th,
	.tbl td {
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}
	.tbl th {
		background: var(--accent-soft);
		color: var(--accent-strong);
	}
	.layers {
		padding-left: 1.2rem;
	}
	.layers li {
		margin: 0.3rem 0;
	}
	.layers strong {
		display: inline-block;
		min-width: 8.5rem;
		color: var(--accent-strong);
	}
	.tpl summary {
		font-size: 1rem;
	}
	.srcs {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 0.9rem;
		margin: 1.25rem 0;
	}
	.src-card {
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface-raised);
	}
	.src-card h4 {
		margin: 0 0 0.3rem;
		font-size: 0.95rem;
	}
	.src-card p {
		font-size: 0.84rem;
	}
	.src-card ul {
		margin: 0.4rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.84rem;
	}

	/* ===== 变体 A · 演讲舞台 ===== */
	.va-rail {
		position: sticky;
		top: 68px;
		z-index: 9;
		display: flex;
		gap: 0.25rem;
		margin: 0 -1rem 1.5rem;
		padding: 0.5rem 1rem;
		overflow-x: auto;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.va-stop {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		padding: 0.3rem 0.7rem;
		border-radius: 10px;
		text-decoration: none;
		line-height: 1.25;
	}
	.va-stop-time {
		color: var(--text-soft);
		font-size: 0.68rem;
	}
	.va-stop-name {
		color: var(--text);
		font-size: 0.85rem;
		font-weight: 600;
	}
	.va-stop:hover {
		background: var(--accent-soft);
	}
	.va-stop.is-current {
		background: var(--accent);
	}
	.va-stop.is-current .va-stop-name,
	.va-stop.is-current .va-stop-time {
		color: var(--accent-soft);
	}
	.va-hero,
	.va-scene {
		min-height: 72vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 3rem 0;
		scroll-margin-top: 76px;
	}
	.va-hero {
		min-height: 80vh;
	}
	.va-hero h1 {
		font-size: clamp(2.2rem, 5vw, 4.2rem);
		margin-bottom: 1rem;
	}
	.va-promise {
		font-size: 1.15rem;
		color: var(--text-soft);
		max-width: 46rem;
	}
	.va-gains {
		margin-top: 1.5rem;
		padding: 1.1rem 1.3rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface-raised);
	}
	.va-gains h3 {
		margin: 0 0 0.5rem;
		font-size: 1rem;
	}
	.va-gains ol {
		margin: 0;
		padding-left: 1.3rem;
	}
	.va-hook {
		margin-top: 1.5rem;
		font-size: 1.05rem;
	}
	.va-scene .pill {
		align-self: flex-start;
		margin-bottom: 0.9rem;
	}

	/* ===== 变体 B · 工程地图 ===== */
	.vb-hero {
		padding: 2.5rem 0 1.5rem;
	}
	.vb-hero h1 {
		font-size: clamp(1.9rem, 4vw, 3.2rem);
	}
	.vb-map {
		margin: 1rem 0 2rem;
		padding: 1.6rem 1.4rem;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--surface-raised);
		box-shadow: var(--shadow);
	}
	.vb-route {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 0.4rem;
		padding: 0;
		margin: 0;
		list-style: none;
		position: relative;
	}
	.vb-route::before {
		content: '';
		position: absolute;
		left: 4%;
		right: 4%;
		top: 1.55rem;
		border-top: 3px solid var(--accent);
		opacity: 0.5;
	}
	.vb-stop-li {
		position: relative;
		text-align: center;
	}
	.vb-stop {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		padding: 0.5rem 0.3rem;
		border-radius: 12px;
		text-decoration: none;
		position: relative;
	}
	.vb-stop:hover {
		background: var(--accent-soft);
	}
	.vb-stop-n {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		border: 3px solid var(--accent);
		background: var(--surface-raised);
		font-weight: 700;
		z-index: 1;
	}
	.theme-prompt .vb-stop-n {
		border-color: #c05b3a;
	}
	.theme-context .vb-stop-n {
		border-color: #7a63c8;
	}
	.theme-loop .vb-stop-n {
		border-color: var(--accent);
	}
	.vb-stop-name {
		font-weight: 700;
		font-size: 0.88rem;
	}
	.vb-stop-time {
		color: var(--text-soft);
		font-size: 0.7rem;
	}
	.vb-stop.is-current .vb-stop-n {
		background: var(--accent);
		color: var(--accent-soft);
	}
	.vb-legend {
		margin: 1rem 0 0;
		color: var(--text-soft);
		font-size: 0.85rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.9rem;
		align-items: center;
	}
	.lg {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.lg::before {
		content: '';
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		border: 2px solid var(--accent);
	}
	.lg-prompt::before {
		border-color: #c05b3a;
	}
	.lg-context::before {
		border-color: #7a63c8;
	}
	.vb-strip {
		position: sticky;
		top: 68px;
		z-index: 9;
		display: flex;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.5rem 0;
		background: color-mix(in srgb, var(--surface) 92%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	.vb-dot {
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 50%;
		border: 2px solid var(--border);
		color: var(--text-soft);
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
		background: var(--surface-raised);
	}
	.vb-dot.is-current {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-soft);
	}
	.vb-station {
		padding: 2.2rem 0;
		border-bottom: 1px solid var(--border);
		scroll-margin-top: 76px;
	}
	.vb-station-head {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.vb-station-n {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--accent);
		color: var(--accent-soft);
		font-size: 1.3rem;
		font-weight: 800;
		flex: 0 0 auto;
	}
	.vb-station-head h2 {
		margin: 0;
		font-size: 1.6rem;
	}
	.vb-station-meta {
		margin: 0.2rem 0 0;
		color: var(--text-soft);
		font-size: 0.88rem;
	}
	.vb-back {
		display: inline-block;
		margin-top: 0.75rem;
		color: var(--text-soft);
		font-size: 0.85rem;
	}

	/* ===== 变体 C · 讲师手册 ===== */
	.vc-grid {
		display: grid;
		grid-template-columns: 230px minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
	}
	.vc-toc {
		position: sticky;
		top: 84px;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 1rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--surface-raised);
		max-height: calc(100vh - 110px);
		overflow-y: auto;
	}
	.vc-toc-title {
		margin: 0 0 0.5rem;
		color: var(--accent-strong);
		font-weight: 800;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
	}
	.vc-toc a {
		padding: 0.32rem 0.55rem;
		border-radius: 8px;
		color: var(--text);
		font-size: 0.88rem;
		text-decoration: none;
	}
	.vc-toc a:hover {
		background: var(--accent-soft);
	}
	.vc-toc a.is-current {
		background: var(--accent);
		color: var(--accent-soft);
		font-weight: 600;
	}
	.vc-hint {
		margin: 0.7rem 0 0;
		color: var(--text-soft);
		font-size: 0.78rem;
	}
	.vc-head h1 {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
	}
	.vc-head p {
		color: var(--text-soft);
	}
	.vc-sec {
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--border);
		scroll-margin-top: 84px;
	}
	.vc-sec h2 {
		font-size: 1.45rem;
	}
	.vc-sec h2 small {
		display: block;
		margin-top: 0.25rem;
		color: var(--text-soft);
		font-size: 0.82rem;
		font-weight: 500;
	}
	.vc-sec ul,
	.vc-sec ol {
		font-size: 0.95rem;
	}
	.vc-sec .keyline {
		font-size: 1.15rem;
	}
	.vc .codeblock {
		font-size: 0.8rem;
	}
	.vc .quiz {
		padding: 0.9rem 1rem;
	}
	.tpl-block {
		margin: 1.25rem 0;
	}
	.tpl-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.tpl-head h3 {
		margin: 0;
	}

	/* ===== 浮动切换条（仅开发环境渲染） ===== */
	.proto-switcher {
		position: fixed;
		bottom: 1.1rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 60;
		display: flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.35rem 0.55rem;
		border-radius: 999px;
		background: var(--text);
		color: var(--surface);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
	}
	.proto-switcher button {
		width: 2.1rem;
		height: 2.1rem;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		font-size: 1rem;
		cursor: pointer;
	}
