---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="搜索 · Niwde" description="搜索 Niwde 的技术文章。">
	<section class="search-page" data-pagefind-ignore>
		<p class="eyebrow">Search</p>
		<h1>搜索</h1>
		<p class="muted">搜索文章标题、正文、分类和标签。</p>
		<div id="search"></div>
		<p id="search-status" class="muted">正在加载搜索索引…</p>
	</section>
</PageLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline>
	(async () => {
		const status = document.querySelector('#search-status');
		try {
			const { PagefindUI } = await import('/pagefind/pagefind-ui.js');
			new PagefindUI({ element: '#search', showSubResults: true, translations: { placeholder: '输入关键词', clear_search: '清除', zero_results: '没有找到 [SEARCH_TERM] 的结果' } });
			status?.remove();
		} catch {
			if (status) status.textContent = '搜索索引在生产构建后可用。';
		}
	})();
</script>

<style>
	.search-page { max-width: 760px; }
	.search-page h1 { margin-bottom: 1rem; }
	#search { margin-top: 2rem; }
	:global(.pagefind-ui__search-input) { background: var(--surface-raised) !important; color: var(--text) !important; }
	:global(.pagefind-ui__result-link) { color: var(--text) !important; }
	:global(.pagefind-ui__result-excerpt) { color: var(--text-soft) !important; }
</style>
